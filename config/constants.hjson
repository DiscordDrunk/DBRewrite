{
	interactionExpiryTimeMs: 30000 // 30 seconds
	bakeTimeRangeMs: [
		20000 // 20 seconds
		90000 // 1.5 minutes
	]
	brewTimeRangeMs: [
		20000 // 20 seconds
		90000 // 1.5 minutes
	]
	work: {
		amountRange: [
			1
			25
		]
		cooldownMs: 300000 // 5 minutes
	}
	daily: {
		amountRange: [
			50
			100
		]
		cooldownMs: 86400000 // 24 hours
	}
	crime: {
		amountRange: [
			50
			100
		]
		cooldownMs: 600000 // 10 minutes
	}

	drinkroulette: {
 	 amountRange: [10, 50]          // how much money the command gives
  	 cooldownMs: 30000              // 30 seconds
 	 dbDrinkChance: 0.4             // 70 % chance to pull from DB (0–1) // if true, only pays when the drink comes from the DB
}
}